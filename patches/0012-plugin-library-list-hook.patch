# libbox64dl patch 0012 (build): one include hook for the generated plugin list.
#
# The wrapped-library plugins are grafted into vendor/box64 (symlinks) and their
# library table entries are generated by `make graft` into
# src/library_list_extra.h. library_list.h is the single place box64 builds its
# static name -> wrapped-library table, so the generated list is appended there.
# With no plugins the generated header is empty and the table is upstream's.
#
# Vendor-only change, kept here so vendor/box64 stays re-syncable; the Makefile
# patch target applies it.

--- a/src/library_list.h
+++ b/src/library_list.h
@@ -448,3 +448,6 @@ GO("ld-linux-x86-64.so.2", ldlinux)
 
 //GO("libunwind.so.8", unwind)
 //GO("crashhandler.so", crashhandler)
+
+/* libbox64dl: wrapped-library plugins, generated by the build. */
+#include "library_list_extra.h"
