+static void fpu_save_fx_registers(x64emu_t* emu, sse_regs_t* regs, int stack)
+{
+    for(int i=0; i<8; ++i) {
+        if(i<stack) {
+            memset(&regs[i], 0, sizeof(regs[i]));
+            D2LD(&ST(i), &regs[i]);
+        } else {
+            memcpy(&regs[i].q[0], &emu->mmx[i], sizeof(mmx87_regs_t));
+        }
+    }
+}
+
+static void fpu_restore_fx_registers(x64emu_t* emu, sse_regs_t* regs, int stack)
+{
+    for(int i=0; i<8; ++i) {
+        if(i<stack)
+            LD2D(&regs[i], &ST(i));
+        else
+            memcpy(&emu->mmx[i], &regs[i].q[0], sizeof(mmx87_regs_t));
+    }
+}
