+static unsigned int fpu_get_logical_tag(x64emu_t* emu, unsigned int logical)
+{
+    const mmx87_regs_t* reg;
+    uint64_t exponent;
+    uint64_t value;
+
+    if (((emu->fpu_tags >> (logical * 2)) & 3) == 3)
+        return 3;
+    reg = &emu->x87[(emu->top + logical) & 7];
+    value = reg->q & 0x7fffffffffffffffULL;
+    if (!value)
+        return 1;
+    exponent = value & 0x7ff0000000000000ULL;
+    if (!exponent || exponent == 0x7ff0000000000000ULL)
+        return 2;
+    return 0;
+}
+
+uint16_t fpu_get_tag_word(x64emu_t* emu)
+{
+    uint16_t tags = 0;
+
+    for (unsigned int i = 0; i < 8; ++i) {
+        unsigned int physical = (emu->top + i) & 7;
+        tags |= fpu_get_logical_tag(emu, i) << (physical * 2);
+    }
+    return tags;
+}
+
+uint8_t fpu_get_abridged_tag_word(x64emu_t* emu)
+{
+    uint8_t tags = 0;
+
+    for (unsigned int i = 0; i < 8; ++i) {
+        unsigned int physical = (emu->top + i) & 7;
+        if (fpu_get_logical_tag(emu, i) != 3)
+            tags |= 1 << physical;
+    }
+    return tags;
+}
+
+void fpu_set_tag_word(x64emu_t* emu, uint16_t tags)
+{
+    emu->fpu_tags = 0;
+    emu->fpu_stack = 0;
+    for (unsigned int i = 0; i < 8; ++i) {
+        unsigned int physical = (emu->top + i) & 7;
+
+        if (((tags >> (physical * 2)) & 3) == 3)
+            emu->fpu_tags |= (uint64_t)3 << (i * 2);
+        else
+            ++emu->fpu_stack;
+    }
+}
+
+void fpu_set_abridged_tag_word(x64emu_t* emu, uint8_t tags)
+{
+    emu->fpu_tags = 0;
+    emu->fpu_stack = 0;
+    for (unsigned int i = 0; i < 8; ++i) {
+        unsigned int physical = (emu->top + i) & 7;
+
+        if (tags & (1 << physical))
+            ++emu->fpu_stack;
+        else
+            emu->fpu_tags |= (uint64_t)3 << (i * 2);
+    }
+}
