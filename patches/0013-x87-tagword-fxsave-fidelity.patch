# libbox64dl patch 0013 (correctness): x87 tag word and FXSAVE register image.
#
# Two defects in the vendored tree's x87 state handling, both observable by a
# guest that saves/restores FPU state (Wine's wow64 and any 32-bit guest that
# uses FSAVE/FXSAVE across a call):
#
#  * FLDENV/FRSTOR wrote the raw 16-bit tag word into emu->fpu_tags, which is
#    box64's *logical* (post-pop) tag representation, while FSTENV/FNSAVE wrote
#    fpu_tags back out as if it were the physical word. The two encodings differ
#    whenever TOP != 0, so a save/restore round trip could mark live registers
#    empty (or the reverse). fpu_get/set_tag_word() and the abridged variants
#    convert between the physical tag word and box64's logical form; they are
#    also used by FXSAVE/FXRSTOR, which previously dumped fpu_tags verbatim.
#  * FXSAVE/FXRSTOR copied ST(i) and the MMX alias registers positionally
#    ((i<stack) ? &ST(i) : &mmx[i]), which is wrong for the abridged tag word:
#    the FP/MMX union must follow the tag word, not the stack depth. The
#    fpu_save/restore_fx_registers() helpers copy each slot as FP or MMX
#    according to the logical tag, and FXSAVE now publishes BOX64_MXCSR_MASK in
#    MXCSR_MASK (some guests read it back).
#
# Vendor-only change, kept here so vendor/box64 stays re-syncable; the Makefile
# patch target applies it.

--- a/src/emu/x87emu_private.c
+++ b/src/emu/x87emu_private.c
@@ -259,15 +259,85 @@ long double LD2localLD(void* ld)
 }
