# libbox64dl patch 0017 (correctness): interpreter FSQRT sets the x87 C0 flag.
#
# The interpreter's D9 /7 FSQRT path computed sqrt() without touching the x87
# status word, so a negative operand raised no flag where x86 sets C0 (and the
# dynarec now matches, patch 0014). Set F87_IE before the operation; the
# remaining rounding changes are upstream's.
#
# Vendor-only change, kept here so vendor/box64 stays re-syncable; the Makefile
# patch target applies it.

--- a/src/emu/x64rund9.c
+++ b/src/emu/x64rund9.c
@@ -240,18 +240,28 @@ uintptr_t RunD9(x64emu_t *emu, rex_t rex, uintptr_t addr)
             fpu_do_pop(emu);
             break;
         case 0xFA:  /* FSQRT */
+            if(ST0.d < 0.0)
+                emu->sw.f.F87_IE = 1;
             oldround = fpu_setround(emu);
             ST0.d = sqrt(ST0.d);
             if(!emu->cw.f.C87_PC) ST0.d = (float)ST0.d;
             fesetround(oldround);
             break;
-        case 0xFB:  /* FSINCOS */
-            fpu_do_push(emu);
-            oldround = fpu_setround(emu);
-            sincos(ST1.d, &ST1.d, &ST0.d);
-            fesetround(oldround);
-            emu->sw.f.F87_C2 = 0;
-            break;
+        case 0xFB:  /* FSINCOS */
+            fpu_do_push(emu);
+            oldround = fpu_setround(emu);
+#if defined(_WIN32) || defined(__MINGW32__)
+            {
+                double v = ST1.d;
+                ST1.d = sin(v);
+                ST0.d = cos(v);
+            }
+#else
+            sincos(ST1.d, &ST1.d, &ST0.d);
+#endif
+            fesetround(oldround);
+            emu->sw.f.F87_C2 = 0;
+            break;
         case 0xFC:  /* FRNDINT */
             ST0.d = fpu_round(emu, ST0.d);
             break;
