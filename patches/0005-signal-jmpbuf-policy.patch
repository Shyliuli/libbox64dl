# libbox64dl patch 0005: per-entry signal-mask policy for the embedded call path.
#
# Every top-level guest call enters EmuRun(), whose SigSetJmp() used the literal
# savesigs=1. On glibc that makes __sigjmp_save() issue an rt_sigprocmask syscall
# per call just to snapshot a mask the no-signal path never reads. The policy is
# now chosen per *library entry scope* and carried on the emu:
#
#   requested_call_policy  the policy for the frame DynaCallCore is about to
#                          enter. DynaCallCore -- the one engine entry every
#                          embedder funnels through (box64_callN/plan/regs, an
#                          arity stub, RunFunctionWithEmu, a wrapped re-entry,
#                          the guest signal handler's DynaCall) -- resolves it
#                          from the real target address and restores the
#                          enclosing value afterwards. EmuRun resolves it from
#                          the entry PC only when it is entered without a
#                          DynaCall (INHERIT, -1).
#   active_jmpbuf_policy   the policy of the frame emu->jmpbuf points at.
#
# EmuRun arms a frame with `savemask = (policy == COMPAT)`, records the policy in
# active_jmpbuf_policy, and restores the enclosing scope's jmpbuf/policy on
# return. A nested EmuRun whose requested policy differs from the live frame's
# takes a NEW frame, so the frame a signal resumes into and the policy its mask
# is restored under always agree; when the policies are equal the original
# nested-sharing behaviour is kept. Every signal-driven siglongjmp() resume
# restores the mask under emu->active_jmpbuf_policy (never a global): a COMPAT
# frame is a no-op (siglongjmp restores the saved mask M0); a FAST frame
# restores the mask the kernel recorded in the delivered signal's ucontext (M1).
#
# Environment library rules are bound in RunElfInit, before any constructor
# guest call runs, so a rule covers a library's constructors as well as later
# calls. An explicit box64_signal_policy_set_library() applies to later host
# entries; by then the constructors have already run under the environment or
# global default policy.
#
# Default is FAST. `none` is parsed only in order to be refused: dynarec's
# protectDB/auto-SMC and guest fatal-signal/SEH emulation depend on the four
# handlers. Vendor-only change, kept here so vendor/box64 stays
# re-syncable; the Makefile patch target applies it.
--- a/src/emu/x64emu_private.h
+++ b/src/emu/x64emu_private.h
@@ -150,6 +150,13 @@
     void*       res_state_32;  //32bits version of res_state
     void*       res_state_64;
     #endif
+    /* libbox64dl patch 0005: signal-mask policy scope.
+     * requested_call_policy is BOX64DL_POLICY_COMPAT/FAST when a host entry
+     * selected the target library's policy, or -1 (INHERIT) to resolve from the
+     * entry PC. active_jmpbuf_policy is the policy of the frame emu->jmpbuf
+     * currently points at; the signal handler restores the mask under it. */
+    int         requested_call_policy;
+    int         active_jmpbuf_policy;
 } x64emu_t;
 
 #define EMUTYPE_NONE    0
--- a/src/emu/x64emu.c
+++ b/src/emu/x64emu.c
@@ -90,6 +90,11 @@
     emu->mxcsr.x32 = 0x1f80;
     // want some new jmpbuf for error recovery
     emu->flags.need_jmpbuf = 1;
+    /* libbox64dl patch 0005: a fresh emu has no scope selected yet, so EmuRun
+     * resolves the policy from its entry PC; no frame is live yet (0 = COMPAT,
+     * which is only observed before the first frame). */
+    emu->requested_call_policy = -1; /* BOX64DL_POLICY_INHERIT */
+    emu->active_jmpbuf_policy = 0;
 }
 
