+        if(!emu->jmpbuf || (emu->flags.need_jmpbuf && emu->jmpbuf!=jmpbuf)
+           || emu->active_jmpbuf_policy != req) {
             emu->jmpbuf = jmpbuf;
             #if defined(RV64) || defined(PPC64LE)
             emu->old_savedsp = emu->xSPSave;
             #endif
