+            emu->active_jmpbuf_policy = req;
+            if (box64dl_sig_dbg_on) box64dl_sig_dbg_note(savemask);
             #ifdef ANDROID
-            if ((skip = SigSetJmp(*(JUMPBUFF*)emu->jmpbuf, 1)))
