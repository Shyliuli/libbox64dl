# libbox64dl patch 0016 (diagnostics): print the local wrapper signatures.
#
# box64's x64printer has a hand-written case per wrapper signature; a signature
# it does not know is printed as a bare "Calling". The engine-owned native
# module seam and the libgccs plugin (src/wrappedbox64dnative_private.h,
# plugins/libgccs/wrappedlibgccs_private.h) introduce seven signatures that
# upstream does not print: iFpdp, iFEppLp, iFpiLpLp, iFEpLpppp, iFEppLppp,
# iFEppLppLpp and iFEppppLLppppp. Their values come from the generated
# src/wrapped/generated/wrapper.h, which is regenerated by the build from the
# grafted private headers, so this patch only adds the case arms.
#
# Vendor-only change, kept here so vendor/box64 stays re-syncable; the Makefile
# patch target applies it.

--- a/src/emu/x64printer.c
+++ b/src/emu/x64printer.c
@@ -1181,6 +1181,8 @@ void x64Print(x64emu_t* emu, char* buff, size_t buffsz, const char* func, int ti
         snprintf(buff, buffsz, "%04d|%p: Calling %s(%" PRIp ", %" PRIf ", %" PRIf ")", tid, *(void**)(R_RSP), func, (void*)R_RDI, emu->xmm[0].f[0], emu->xmm[1].f[0]);
     } else if (w == iFpdd) {
         snprintf(buff, buffsz, "%04d|%p: Calling %s(%" PRIp ", %" PRIf ", %" PRIf ")", tid, *(void**)(R_RSP), func, (void*)R_RDI, emu->xmm[0].d[0], emu->xmm[1].d[0]);
+    } else if (w == iFpdp) {
+        snprintf(buff, buffsz, "%04d|%p: Calling %s(%" PRIp ", %" PRIf ", %" PRIp ")", tid, *(void**)(R_RSP), func, (void*)R_RDI, emu->xmm[0].d[0], (void*)R_RSI);
     } else if (w == iFpli) {
         snprintf(buff, buffsz, "%04d|%p: Calling %s(%" PRIp ", %" PRIi64 ", %" PRIi32 ")", tid, *(void**)(R_RSP), func, (void*)R_RDI, (intptr_t)R_RSI, (int32_t)R_RDX);
     } else if (w == iFpll) {
@@ -3457,6 +3459,8 @@ void x64Print(x64emu_t* emu, char* buff, size_t buffsz, const char* func, int ti
         snprintf(buff, buffsz, "%04d|%p: Calling %s(%" PRIp ", %" PRIp ", %" PRIu32 ", %" PRIp ")", tid, *(void**)(R_RSP), func, (void*)R_RDI, (void*)R_RSI, (uint32_t)R_RDX, (void*)R_RCX);
