# libbox64dl patch 0006 (correctness, not perf): fini must restore the host
# actions, not SIG_DFL.
#
# Two places reset SIGSEGV/SIGBUS/SIGILL/SIGABRT at teardown:
#  1. fini_signal_helper() set all four to SIG_DFL, which permanently eats a
#     host handler box64 replaced at init (V8's wasm trap handler among them).
#     The old post-endBox64 "restore if still ours" attempt could not work
#     either: by then the disposition was already SIG_DFL.
#  2. FreeBox64Context()'s ctx->signals[] loop ran BEFORE finiAllHelpers and
#     reset any guest-registered signal (including the four box64 owns, since a
#     guest fatal handler is stored in ctx->signals[]) to SIG_DFL, so
#     fini_signal_helper's ownership check saw SIG_DFL and skipped the restore.
#
# This patch makes fini_signal_helper restore the saved pre-box64 action for any
# signal whose current disposition is STILL box64's own handler (so a later host
# action is left alone), and makes the FreeBox64Context loop skip the four
# signals so fini_signal_helper is their single owner. It runs inside
# endBox64(), while box64's handler is still installed, so the ownership test is
# real. No thread teardown path changes; the sigaction() calls only affect the
# calling thread's process dispositions and the saved structs are
# process-lifetime globals (valid even as the context is freed).
#
# Vendor-only change, kept here so third_party/box64 stays re-syncable; the
# Makefile patch target applies it (after patch 0005; different files/hunks).

--- a/src/box64context.c
+++ b/src/box64context.c
@@ -346,10 +346,23 @@
         ctx->atfork_sz = ctx->atfork_cap = 0;
     }
 
-    for(int i=0; i<MAX_SIGNAL; ++i)
+    for(int i=0; i<MAX_SIGNAL; ++i) {
+        /* libbox64dl patch 0006: the four signals box64 installs itself
+         * (SIGSEGV/SIGBUS/SIGILL/SIGABRT) are the property of
+         * init_signal_helper/fini_signal_helper. Resetting them to SIG_DFL here
+         * runs BEFORE finiAllHelpers -> fini_signal_helper, whose ownership
+         * check would then see SIG_DFL instead of box64's handler and skip the
+         * restore, permanently eating the host action box64 replaced at init
+         * (e.g. a guest-registered fatal handler is stored in ctx->signals[]
+         * and would trigger exactly that). Let fini_signal_helper be the single
+         * owner: it restores the saved pre-box64 action for any signal still
+         * owned by box64 and leaves a later host action alone. */
+        if(i==SIGSEGV || i==SIGBUS || i==SIGILL || i==SIGABRT)
+            continue;
         if(ctx->signals[i]!=0 && ctx->signals[i]!=1) {
             signal(i, SIG_DFL);
         }
+    }
 
     *context = NULL;                // bye bye my_context
 
--- a/src/libtools/signals.c
+++ b/src/libtools/signals.c
@@ -1740,10 +1740,26 @@
 
 void fini_signal_helper()
 {
-    signal(SIGSEGV, SIG_DFL);
-    signal(SIGBUS, SIG_DFL);
-    signal(SIGILL, SIG_DFL);
-    signal(SIGABRT, SIG_DFL);
+    /* libbox64dl patch 0006: resetting these four signals to SIG_DFL eats a
+     * host handler box64 replaced at init (V8's wasm trap handler among them).
+     * Restore the actions init_signal_helper saved instead, but only for a
+     * signal whose disposition is STILL box64's own handler: if the host
+     * re-installed something after init, that newer action is left in place.
+     * This runs while box64's handler is still installed (nothing has replaced
+     * it yet in this teardown path), so the guard is a real ownership test, not
+     * an assumed SIG_DFL. */
+    struct sigaction cur;
+    #define BOX64DL_RESTORE(SIG, PRE)                                          \
+        do {                                                                   \
+            if(sigaction(SIG, NULL, &cur)==0 &&                                \
+               cur.sa_sigaction == (void (*)(int, siginfo_t*, void*))my_box64signalhandler) \
+                sigaction(SIG, &(PRE), NULL);                                  \
+        } while(0)
+    BOX64DL_RESTORE(SIGSEGV, box64dl_pre_segv);
+    BOX64DL_RESTORE(SIGBUS, box64dl_pre_bus);
+    BOX64DL_RESTORE(SIGILL, box64dl_pre_ill);
+    BOX64DL_RESTORE(SIGABRT, box64dl_pre_abrt);
+    #undef BOX64DL_RESTORE
 }
 
 #ifdef NEED_SIG_CONV
