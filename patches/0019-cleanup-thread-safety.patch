+    // Entries are consumed from the top, which is the order the original
+    // downward loop produced. The callback runs with the lock released: a
+    // destructor is allowed to register another cleanup, and holding the lock
+    // across guest code would deadlock on that.
+    for(;;) {
+        cleanup_t entry;
+        int index;
+        pthread_mutex_lock(&cleanup_mutex);
+        index = h->clean_sz - 1;
+        if(index < 0) {
