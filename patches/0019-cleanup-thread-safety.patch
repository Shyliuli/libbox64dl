# libbox64dl patch 0019 (correctness): serialise the atexit / thread-local
# destructor tables.
#
# The cleanup tables are shared process state, but every access to them was
# unsynchronised. src/tools/cleanup.c was the only writer and the only reader:
#
#  * AddCleanup() appends to my_context->cleanups / clean_sz / clean_cap, which
#    every emulated thread can reach;
#  * AddCleanup1Arg() appends to the h->cleanups / clean_sz / clean_cap of ONE
#    elfheader_t, which is shared by every thread running that ELF.
#
# Wrapped libc calls are not serialised by the engine: x64Int3() releases
# mutex_trace before invoking the wrapper precisely because the wrapped function
# may block. So concurrent registration is real, and a guest that registers
# destructors from several threads at once reaches AddCleanup1Arg() in parallel.
# The guest needs no unusual code to do that: any C++ thread_local object with a
# destructor calls __cxa_thread_atexit_impl -> my___cxa_thread_atexit_impl()
# (src/wrapped/wrappedlibc.c) -> AddCleanup1Arg(), as does a Rust addon that
# starts a worker pool.
#
# Two distinct defects followed from the missing serialisation:
#
#  * Two threads could both pass the "size == capacity" test and store into the
#    same slot, losing one registration; and a thread appending while another
#    was inside box_realloc() wrote past the old buffer, over the next malloc
#    chunk header. glibc then reported "invalid next size" or the append itself
#    faulted on a stale pointer.
#  * The growth path published the new capacity BEFORE box_realloc() returned,
#    so a thread that only read the pair could see "size < capacity" while the
#    buffer still had the old, smaller size - a second way to append out of
#    bounds, independent of the size counter race.
#
# Fix: one file-local mutex around every access to both tables, and the growth
# paths publish the new pointer and capacity only after a successful
# box_realloc(). CallCleanup()/CallAllCleanup() hold the lock just long enough
# to detach one entry, then call the guest destructor with the lock released,
# because a destructor may register another cleanup and would otherwise
# deadlock. Entries are still consumed from the top, which is the order the
# original downward loop produced (its memmove() branch was unreachable: i and
# clean_sz decremented together, so i was always clean_sz-1).
#
# A file-local mutex is deliberate. box64context_t's mutex_* fields exist in two
# incompatible flavours (pthread_mutex_t, and a uint32_t native lock when the
# dynarec flavour is selected), so using one would couple this fix to that
# choice and to the context layout; the cleanup tables are the only shared state
# in this file, so a PTHREAD_MUTEX_INITIALIZER needs no init/teardown and no
# struct change.
#
# CallAllCleanup() additionally now resets clean_sz and clean_cap together with
# the pointer. It previously freed the buffer and set cleanups = NULL while
# leaving clean_cap at its old value, so the next AddCleanup() saw
# "size != capacity", skipped the growth branch, and appended through NULL. That
# matches upstream main, which resets both fields.
#
# Vendor-only change, kept here so vendor/box64 stays re-syncable; the Makefile
# patch target applies it.

--- a/src/tools/cleanup.c
+++ b/src/tools/cleanup.c
@@ -1,4 +1,5 @@
 #include <string.h>
+#include <pthread.h>
 
 #include "cleanup.h"
 #include "elfs/elfloader_private.h"
@@ -12,32 +13,75 @@
     void*       a;
 } cleanup_t;
 
+/*
+ * The two tables below are shared process state, not per-thread state: the
+ * context-wide list is reachable from every emulated thread, and ONE
+ * elfheader_t is shared by every thread running that ELF. Wrapped libc calls
+ * are not serialised by the engine (see x64Int3, which drops its trace lock
+ * before calling the wrapper), so a guest that registers destructors from
+ * several threads at once - any C++ thread_local object, or a Rust addon
+ * starting a worker pool - races here.
+ *
+ * Concretely, with the growth branch below unlocked, two threads can both pass
+ * the "size == capacity" test and append to the same slot, and a thread that
+ * appends while another one is inside box_realloc() writes past the old buffer,
+ * over the next malloc chunk header. A single file-local mutex serialises every
+ * access, so the tables are only ever seen in a consistent state. A file-local
+ * mutex is used instead of a box64context_t mutex_* field because those fields
+ * exist in two incompatible flavours (pthread_mutex_t and a uint32_t native
+ * lock) and the cleanup tables are the only shared state in this file.
+ *
+ * The growth paths publish the new pointer and capacity only after a successful
+ * box_realloc(), so the table is never described as larger than it is - even
+ * without the lock that ordering would be the minimal requirement.
+ */
+static pthread_mutex_t cleanup_mutex = PTHREAD_MUTEX_INITIALIZER;
+
 void AddCleanup(x64emu_t *emu, void *p)
 {
     (void)emu;
 
+    pthread_mutex_lock(&cleanup_mutex);
     if(my_context->clean_sz == my_context->clean_cap) {
-        my_context->clean_cap += 32;
-        my_context->cleanups = (cleanup_t*)box_realloc(my_context->cleanups, sizeof(cleanup_t)*my_context->clean_cap);
+        int cap = my_context->clean_cap + 32;
+        cleanup_t* grown = (cleanup_t*)box_realloc(my_context->cleanups, sizeof(cleanup_t)*cap);
+        if(!grown) {
+            // Keep the existing table usable rather than recording a capacity
+            // that has no buffer behind it.
+            pthread_mutex_unlock(&cleanup_mutex);
+            return;
+        }
+        my_context->cleanups = grown;
+        my_context->clean_cap = cap;
     }
     my_context->cleanups[my_context->clean_sz].arg = 0;
     my_context->cleanups[my_context->clean_sz].a = NULL;
     my_context->cleanups[my_context->clean_sz++].f = p;
+    pthread_mutex_unlock(&cleanup_mutex);
 }
 
 void AddCleanup1Arg(x64emu_t *emu, void *p, void* a, elfheader_t* h)
 {
     (void)emu;
+
+    pthread_mutex_lock(&cleanup_mutex);
     if (!h)
         h = my_context->elfs[0];
 
     if(h->clean_sz == h->clean_cap) {
-        h->clean_cap += 32;
-        h->cleanups = (cleanup_t*)box_realloc(h->cleanups, sizeof(cleanup_t)*h->clean_cap);
+        int cap = h->clean_cap + 32;
+        cleanup_t* grown = (cleanup_t*)box_realloc(h->cleanups, sizeof(cleanup_t)*cap);
+        if(!grown) {
+            pthread_mutex_unlock(&cleanup_mutex);
+            return;
+        }
+        h->cleanups = grown;
+        h->clean_cap = cap;
     }
     h->cleanups[h->clean_sz].arg = 1;
     h->cleanups[h->clean_sz].a = a;
     h->cleanups[h->clean_sz++].f = p;
+    pthread_mutex_unlock(&cleanup_mutex);
 }
 
 void CallCleanup(x64emu_t *emu, elfheader_t* h)
@@ -45,24 +89,52 @@
     printf_log(LOG_DEBUG, "Calling atexit registered functions for elf: %p/%s\n", h, h?h->name:"(nil)");
     if(!h)
         return;
-    for(int i=h->clean_sz-1; i>=0; --i) {
-        printf_log(LOG_DEBUG, "Call cleanup #%d (args:%d, arg:%p)\n", i, h->cleanups[i].arg, h->cleanups[i].a);
-        RunFunctionWithEmu(emu, 0, (uintptr_t)(h->cleanups[i].f), h->cleanups[i].arg, h->cleanups[i].a );
