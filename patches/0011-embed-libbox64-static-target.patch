# libbox64dl patch 0011 (build): build box64 as an embeddable static library.
#
# `make` links libbox64dl's two flavours against libbox64.a / libdynarec.a from
# the vendored tree, and the Rust crate (rust/build.rs) links the Rust shim
# against the same archives. The vendored tree as shipped upstream only builds
# the `box64` program, so the embedded target has to exist here.
#
# Three changes, all in CMakeLists.txt:
#
#  * split the program sources (main.c, test.c) out of ELFLOADER_SRC into
#    BOX64_MAIN_SRC, so the runtime objects can be archived separately;
#  * add the `libbox64` STATIC target (mainobj + dynarec + interpreter,
#    OUTPUT_NAME box64) and make the `box64` executable a thin main that links
#    it PRIVATE. SHARED is deliberately not used: it fights LA64 TLS_LE in the
#    dynarec;
#  * include the two generated include lists (box64dl_core.cmake: the grafted
#    ELFLOADER sources; box64dl_plugins.cmake: the grafted/engine-owned wrapped
#    libraries) and add -rdynamic to the program link so the embedded engine
#    keeps exporting the symbols its guests resolve.
#
# The include lines are optional (`include(... OPTIONAL)`), so a pristine tree
# without `make graft` still configures.
#
# Vendor-only change, kept here so vendor/box64 stays re-syncable; the Makefile
# patch target applies it.

--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -413,9 +413,12 @@ set(OS_LINUX_SRC
     "${BOX64_ROOT}/src/os/sysinfo.c"
 )
 
-set(ELFLOADER_SRC
+set(BOX64_MAIN_SRC
     "${BOX64_ROOT}/src/main.c"
     "${BOX64_ROOT}/src/test.c"
+)
+
+set(ELFLOADER_SRC
     "${BOX64_ROOT}/src/core.c"
     "${BOX64_ROOT}/src/box64context.c"
     "${BOX64_ROOT}/src/build_info.c"
@@ -465,6 +468,9 @@ set(ELFLOADER_SRC
     "${BOX64_ROOT}/src/tools/pe_tools.c"
     "${BOX64_ROOT}/src/wrapped/generated/wrapper.c"
 )
+
+# libbox64dl: embeddable-runtime sources (symlinked in; list generated).
+include("${BOX64_ROOT}/box64dl_core.cmake" OPTIONAL)
 if(NOT STATICBUILD)
     list(APPEND ELFLOADER_SRC
         "${BOX64_ROOT}/src/mallochook.c"
@@ -857,6 +863,9 @@ if(TERMUX)
     )
 endif()
 
+# libbox64dl: wrapped-library plugins (list(APPEND WRAPPEDS ...)), generated.
+include("${BOX64_ROOT}/box64dl_plugins.cmake" OPTIONAL)
+
 # If BOX64_ROOT contains a ".c", the build breaks...
 string(REPLACE ".c" "_private.h" MODROOT ${BOX64_ROOT})
 set(WRAPPEDS_HEAD "${BOX64_ROOT}/src/wrapped/wrappedd3dadapter9_genvate.h")
@@ -1297,34 +1306,42 @@ add_library(interpreter OBJECT ${INTERPRETER})
 add_library(mainobj OBJECT ${OS_LINUX_SRC} ${ELFLOADER_SRC} ${WRAPPEDS} ${WRAPPEDS32})
 add_dependencies(mainobj generate_git_head_target)
 
-add_executable(${BOX64})
-target_link_libraries(${BOX64} mainobj)
+# ---- libbox64 (static embeddable; SHARED fights LA64 TLS_LE in dynarec) ----
+add_library(libbox64 STATIC)
+target_link_libraries(libbox64 PUBLIC mainobj)
+if(DYNAREC)
+    target_link_libraries(libbox64 PUBLIC dynarec)
+endif()
+target_link_libraries(libbox64 PUBLIC interpreter)
+set_target_properties(libbox64 PROPERTIES OUTPUT_NAME box64)
+add_dependencies(libbox64 WRAPPERS)
+if(BOX32)
+    add_dependencies(libbox64 WRAPPERS32)
+endif()
+target_include_directories(libbox64 PUBLIC "${BOX64_ROOT}/src/include")
+
+# ---- box64 executable (thin main + libbox64) ----
+add_executable(${BOX64} ${BOX64_MAIN_SRC})
+target_link_libraries(${BOX64} PRIVATE libbox64)
 set_target_properties(${BOX64} PROPERTIES ENABLE_EXPORTS ON)
 add_dependencies(${BOX64} WRAPPERS)
 if(BOX32)
     add_dependencies(${BOX64} WRAPPERS32)
 endif()
-#add_dependencies(${BOX64} PRINTER)
-#target_link_libraries(${BOX64} c m dl rt pthread resolv)
 if(STATICBUILD)
-    #set_target_properties(${BOX64} PROPERTIES LINK_FLAGS "-fuse-ld=gold -static -Wl,--no-relax -Wl,--allow-multiple-definition -ldl -lrt -lpthread -lresolv -lc -lutil -lm -Wl,-defsym,_DYNAMIC=0 -pthread")
-    target_link_libraries(${BOX64} c m dl pthread resolv util c)
+    target_link_libraries(${BOX64} PRIVATE c m dl pthread resolv util c)
 else()
     if(ANDROID)
         if(TERMUX)
-        target_link_libraries(${BOX64} c m dl android-sysv-semaphore)
+            target_link_libraries(${BOX64} PRIVATE c m dl android-sysv-semaphore)
         else()
-        target_link_libraries(${BOX64} c m dl)
+            target_link_libraries(${BOX64} PRIVATE c m dl)
         endif()
     else()
-	    set_property(TARGET ${BOX64} APPEND_STRING PROPERTY LINK_FLAGS "-Wl,--no-as-needed -lc -lm -ldl -lrt -lpthread -lresolv -lutil -Wl,--as-needed -pthread ")
-		target_link_libraries(${BOX64} c m dl pthread resolv util c)
+        set_property(TARGET ${BOX64} APPEND_STRING PROPERTY LINK_FLAGS "-Wl,--no-as-needed -lc -lm -ldl -lrt -lpthread -lresolv -lutil -Wl,--as-needed -pthread -rdynamic ")
+        target_link_libraries(${BOX64} PRIVATE c m dl pthread resolv util c)
     endif()
 endif()
-if(DYNAREC)
-    target_link_libraries(${BOX64} dynarec)
-endif()
-target_link_libraries(${BOX64} interpreter)
 
 if(${CMAKE_VERSION} VERSION_LESS "3.13")
     if(NOT NOLOADADDR)
