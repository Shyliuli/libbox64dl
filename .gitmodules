[submodule "vendor/box64"]
	path = vendor/box64
	url = https://github.com/ptitSeb/box64.git
	# `make patch`/`make graft` modify the checked-out submodule on purpose
	# (patches 0001..0018, graft symlinks, generated wrapper heads) and `make`
	# drops its build trees under vendor/box64/build*. The superproject must not
	# report that as work to commit, but a *committed* difference (a moved
	# submodule pointer) must still be visible, so ignore untracked content
	# only.
	ignore = untracked
