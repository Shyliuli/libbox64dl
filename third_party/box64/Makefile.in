EXTLIB    = libbox64.a
EXTRAINCL = $(BOX64_PE_CFLAGS) $(ZYDIS_PE_CFLAGS)
EXTRADEFS = -DDYNAREC -DLA64 -DWIN32 -DWINE_BOX64CPU_EXTERNAL_ALLOCATORS -DWINE_BOX64CPU_EXTERNAL_ENV -DWINE_BOX64CPU_ENV_MAPPING_ONLY -DWINE_BOX64CPU_NO_TEST_INTERPRETER -DWINE_BOX64CPU_NO_WRAPPER_FASTPATH -DWINE_BOX64CPU_SIGTOOLS_AUTOSMC_ONLY -D_ACRTIMP= -D_NO_CRT_MATH_INLINE

